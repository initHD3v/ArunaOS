{
  "name": "@arunaos/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers/*": {
      "types": "./src/providers/*.ts",
      "import": "./src/providers/*.ts",
      "default": "./src/providers/*.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules dist"
  },
  "devDependencies": {
    "@arunaos/types": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
